{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Trusted app and creator windows",
  "windows": ["main", "creator_*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen"
  ]
}
