{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main launcher window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen"
  ]
}
